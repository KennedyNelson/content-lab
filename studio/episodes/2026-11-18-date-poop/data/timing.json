[
{
"line": 0,
"sp": "n",
"start": 0.1,
"end": 6.578,
"text": "\u0906\u092a \u0905\u092a\u0928\u0940 \u092c\u0902\u0926\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0921\u0947\u091f \u092a\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a\u0915\u094b \u0906\u0908 \u091c\u093c\u094b\u0930 \u0938\u0947 \u092a\u093e\u0926, \u092a\u0930 \u0906\u092a\u0928\u0947 \u0910\u0938\u0940 \u092a\u093e\u0926 \u092e\u093e\u0930\u0940 \u0915\u093f \u091a\u0921\u094d\u0921\u0940 \u092e\u0947\u0902 \u0939\u0940 \u0939\u0917\u094d\u0917\u093e \u0928\u093f\u0915\u0932 \u0917\u092f\u093e\u0964"
},
{
"line": 1,
"sp": "n",
"start": 7.628,
"end": 12.206,
"text": "\u091f\u0947\u092c\u0932 \u092a\u0930 \u092e\u094b\u092e\u092c\u0924\u094d\u0924\u0940 \u091c\u0932 \u0930\u0939\u0940 \u0939\u0948, \u0914\u0930 \u0928\u0940\u091a\u0947 \u0938\u0947 \u0917\u0930\u092e\u093e \u0917\u0930\u092e \u0917\u0942 \u0915\u093e \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u092b\u0948\u0932 \u0930\u0939\u093e \u0939\u0948\u0964"
},
{
"line": 2,
"sp": "g",
"start": 12.306,
"end": 14.511,
"text": "\u092f\u0947... \u092f\u0947 \u0938\u094d\u092e\u0947\u0932 \u0915\u0948\u0938\u0940 \u0939\u0948?"
},
{
"line": 3,
"sp": "n",
"start": 14.611,
"end": 20.077,
"text": "\u0924\u0941\u092e \u092c\u094b\u0932\u0924\u0947 \u0939\u094b, \u0936\u093e\u092f\u0926 \u092c\u0917\u0932 \u0935\u093e\u0932\u0940 \u091f\u0947\u092c\u0932 \u0938\u0947 \u0906 \u0930\u0939\u0940 \u0939\u0948\u0964 \u092c\u0917\u0932 \u0935\u093e\u0932\u0947 \u0905\u0902\u0915\u0932 \u0928\u0947 \u0910\u0938\u0947 \u0926\u0947\u0916\u093e \u091c\u0948\u0938\u0947 \u0938\u092c \u092a\u0924\u093e \u0939\u094b\u0964"
},
{
"line": 4,
"sp": "n",
"start": 20.177,
"end": 24.177,
"text": "\u092c\u093f\u0932 \u0926\u093f\u092f\u093e \u0914\u0930 \u092a\u0947\u0902\u0917\u0941\u0907\u0928 \u0915\u0940 \u0924\u0930\u0939 \u092a\u0948\u0930 \u092b\u0948\u0932\u093e \u0915\u0947 \u0928\u093f\u0915\u0932 \u0932\u093f\u090f, \u0907\u091c\u093c\u094d\u091c\u093c\u0924 \u0915\u0940 \u0932\u093e\u0936 \u0909\u0920\u093e\u090f\u0964"
},
{
"line": 5,
"sp": "n",
"start": 24.277,
"end": 27.533,
"text": "\u092a\u0930 \u0915\u093f\u0938\u094d\u092e\u0924 \u0926\u0947\u0916\u094b, \u0932\u0921\u093c\u0915\u0940 \u0928\u0947 \u092e\u093e\u092b\u093c \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u092c\u094b\u0932\u0940, \u091a\u0932 \u0924\u0947\u0930\u0947 \u0918\u0930 \u091a\u0932\u0924\u0947 \u0939\u0948\u0902\u0964"
},
{
"line": 6,
"sp": "n",
"start": 27.683,
"end": 33.709,
"text": "\u0930\u093e\u0924, \u0915\u092e\u0930\u093e, \u0932\u093e\u0907\u091f \u092c\u0902\u0926, \u091c\u0948\u0938\u0947 \u0939\u0940 \u092e\u093e\u092e\u0932\u093e \u0917\u0930\u092e \u0939\u0941\u0906, \u092a\u0947\u091f \u092e\u0947\u0902 \u092b\u093f\u0930 \u0917\u0941\u0921\u093c\u0917\u0941\u0921\u093c\u0964 \u0914\u0930 \u0907\u0938 \u092c\u093e\u0930 \u092d\u0940 \u091a\u0921\u094d\u0921\u0940 \u092e\u0947\u0902 \u0939\u0917\u094d\u0917\u093e\u0964"
},
{
"line": 7,
"sp": "g",
"start": 34.709,
"end": 35.741,
"text": "\u0924\u0942 \u0926\u094b\u092c\u093e\u0930\u093e?!"
},
{
"line": 8,
"sp": "n",
"start": 35.941,
"end": 38.893,
"text": "\u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u0909\u0938\u0928\u0947 \u0938\u094d\u091f\u094b\u0930\u0940 \u0921\u093e\u0932\u0940, \u0930\u0947\u0921 \u092b\u094d\u0932\u0948\u0917 \u0928\u0939\u0940\u0902, \u092c\u094d\u0930\u093e\u0909\u0928 \u092b\u094d\u0932\u0948\u0917\u0964"
}
]