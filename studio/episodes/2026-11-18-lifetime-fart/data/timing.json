[
{
"line": 0,
"sp": "n",
"start": 0.1,
"end": 6.391,
"text": "\u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u090f\u0915 \u092a\u093e\u0926 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u092a\u0942\u0930\u0947 \u091c\u0940\u0935\u0928 \u0915\u0940 \u0938\u093e\u0930\u0940 \u092a\u093e\u0926\u0947\u0902 \u092e\u093e\u0930 \u0926\u0940 \u0924\u094b \u0906\u092a\u0915\u0940 \u0917\u093e\u0902\u0921 \u092b\u091f\u0947\u0917\u0940 \u092f\u093e \u091c\u0941\u0921\u093c\u0940 \u0930\u0939\u0947\u0917\u0940, \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964"
},
{
"line": 1,
"sp": "n",
"start": 6.511,
"end": 12.278,
"text": "\u092a\u0939\u0932\u0947 \u0939\u093f\u0938\u093e\u092c\u0964 \u0930\u094b\u091c\u093c \u091a\u094c\u0926\u0939 \u092a\u093e\u0926\u0947\u0902, \u0905\u0938\u094d\u0938\u0940 \u0938\u093e\u0932 \u092e\u0947\u0902 \u091a\u093e\u0930 \u0932\u093e\u0916\u0964 \u092e\u0924\u0932\u092c \u092c\u0940\u0938 \u0939\u091c\u093c\u093e\u0930 \u0932\u0940\u091f\u0930 \u0917\u0948\u0938, \u092a\u0942\u0930\u093e \u0915\u092e\u0930\u093e \u092d\u0930 \u091c\u093e\u090f\u0964"
},
{
"line": 2,
"sp": "n",
"start": 12.378,
"end": 19.324,
"text": "\u0914\u0930 \u092a\u0947\u091f \u092e\u0947\u0902 \u091c\u0917\u0939? \u0938\u093f\u0930\u094d\u092b \u0938\u0924\u094d\u0924\u0930 \u0932\u0940\u091f\u0930\u0964 \u092f\u093e\u0928\u0940 \u0924\u0940\u0928 \u0938\u094c \u0917\u0941\u0928\u093e \u0926\u092c\u093e\u0935, \u0924\u0941\u092e \u0907\u0902\u0938\u093e\u0928 \u0928\u0939\u0940\u0902, \u091a\u0932\u0924\u093e-\u092b\u093f\u0930\u0924\u093e \u0917\u0948\u0938 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u0939\u094b\u0964"
},
{
"line": 3,
"sp": "n",
"start": 19.424,
"end": 24.438,
"text": "\u0917\u093e\u0902\u0921 \u0928\u0939\u0940\u0902 \u092b\u091f\u0947\u0917\u0940 \u092d\u093e\u0908\u0964 \u0935\u094b \u0924\u094b \u0932\u094b\u0939\u0947 \u0915\u0940 \u091a\u094c\u0915\u0940\u0926\u093e\u0930 \u0939\u0948, \u0921\u091f\u0940 \u0930\u0939\u0947\u0917\u0940\u0964 \u092b\u091f\u0947\u0917\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0947\u091f\u0964"
},
{
"line": 4,
"sp": "n",
"start": 24.538,
"end": 29.5,
"text": "\u0914\u0930 \u0905\u0917\u0930 \u0909\u0938\u0928\u0947 \u0917\u0947\u091f \u0916\u094b\u0932 \u0926\u093f\u092f\u093e, \u0924\u094b \u092a\u093e\u0926 \u0928\u0939\u0940\u0902, \u0930\u0949\u0915\u0947\u091f \u0932\u0949\u0928\u094d\u091a \u0939\u0948\u0964 \u091b\u0924 \u092b\u093e\u0921\u093c \u0915\u0947 \u0938\u0940\u0927\u093e \u090a\u092a\u0930!"
},
{
"line": 5,
"sp": "n",
"start": 31.2,
"end": 36.015,
"text": "\u0924\u094b \u0928\u0924\u0940\u091c\u093e? \u0917\u093e\u0902\u0921 \u0938\u0932\u093e\u092e\u0924, \u092a\u0948\u0902\u091f \u0936\u0939\u0940\u0926, \u0914\u0930 \u0907\u091c\u093c\u094d\u091c\u093c\u0924 \u0935\u094b \u0924\u094b \u090a\u092a\u0930 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0928\u093f\u0915\u0932 \u0917\u0908 \u0925\u0940\u0964"
}
]